# iratanshOS analytics configuration. See ANALYTICS.md.
# Every variable here is OPTIONAL and PUBLIC (VITE_ = embedded in the shipped JavaScript).
# This site uses no analytics API credentials. Never add one with a VITE_ prefix.

# Override the Cloudflare Web Analytics beacon token (default lives in src/analytics/config.ts).
# VITE_CF_BEACON_TOKEN=

# Enable custom interaction events via GoatCounter: https://<your-code>.goatcounter.com/count
# VITE_GOATCOUNTER_ENDPOINT=

# Switches
# VITE_ANALYTICS_DISABLED=true   # never load any provider
# VITE_ANALYTICS_IN_DEV=true     # load providers during `npm run dev` (off by default)
# VITE_ANALYTICS_DEBUG=true      # log events to the console in production builds
